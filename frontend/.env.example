# GitHub Configuration
# Required: GitHub Personal Access Token or GitHub App credentials
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub App Authentication (alternative to personal token)
# If using GitHub App, provide these instead of GITHUB_TOKEN
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_INSTALLATION_ID=12345678

# Required: Repository Information
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=VexRobotics25
GITHUB_DEFAULT_BRANCH=homeGrown-Auton

# Required: Webhook Secret for security
GITHUB_WEBHOOK_SECRET=9f2c7a6d4b01f3c876eb25a17d9c45b0 # Example Webhook Secret 

# Optional: Deployment Configuration
DEPLOYMENT_URL=https://your-raspberry-pi.local:3000

# Optional: Polling Configuration (milliseconds)
GITHUB_POLLING_INTERVAL=30000

# Optional: Rate Limiting
GITHUB_RATE_LIMIT_ENABLED=true
GITHUB_RATE_LIMIT_MAX_REQUESTS=5000